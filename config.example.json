{
  "records": "~/research-records",
  "adoption_tracks": [],
  "scout_survivors": 3,
  "duplicate_threshold": 0.35,
  "prior_art": {
    "sources": [
      "arxiv",
      "semantic_scholar",
      "github"
    ],
    "per_source": 5
  },
  "auto_commit": true,
  "max_call_minutes": 60,
  "task_name": "rigour-night",
  "roles": {
    "precheck": {
      "agent": "claude-a",
      "model": "haiku",
      "effort": "low"
    },
    "scout": {
      "agent": "claude-a",
      "model": "sonnet",
      "effort": "medium",
      "skills": [
        "vetted-idea-generation"
      ]
    },
    "novelty1": {
      "agent": "claude-a",
      "model": "sonnet",
      "effort": "medium"
    },
    "novelty2": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "medium"
    },
    "tiebreak": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "medium",
      "fallback_model": "sonnet"
    },
    "referee_spec": {
      "agent": "claude-a",
      "model": "sonnet",
      "effort": "medium"
    },
    "builder": {
      "agent": "claude-a",
      "model": "sonnet",
      "effort": "medium"
    },
    "referee_judge": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "medium",
      "fallback_model": "sonnet"
    },
    "synth": {
      "agent": "claude-a",
      "model": "haiku",
      "effort": "low"
    },
    "triage": {
      "agent": "claude-a",
      "model": "haiku",
      "effort": "low"
    }
  },
  "fallback": {
    "codex": "claude-b"
  },
  "budget": {
    "session_usd": 5,
    "day_usd": 10,
    "five_hour_pct": null,
    "seven_day_pct": null
  },
  "independence": "session",
  "agents": {
    "claude-a": {
      "kind": "claude",
      "env": {}
    },
    "claude-b": {
      "kind": "claude",
      "env": {
        "CLAUDE_CONFIG_DIR": "~/.claude-b"
      }
    },
    "codex": {
      "kind": "codex",
      "env": {
        "CODEX_HOME": "~/.codex-rigour"
      }
    }
  }
}
