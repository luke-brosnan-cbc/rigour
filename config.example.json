{
  "records": "~/research-records",
  "auto_commit": true,
  "max_call_minutes": 60,
  "task_name": "rigour-night",
  "agents": {
    "claude-a": {
      "kind": "claude",
      "env": {}
    },
    "claude-b": {
      "kind": "claude",
      "env": {
        "CLAUDE_CONFIG_DIR": "~/.claude-b"
      }
    },
    "codex": {
      "kind": "codex",
      "env": {}
    }
  },
  "roles": {
    "scout": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "high",
      "fallback_model": "sonnet",
      "skills": [
        "vetted-idea-generation"
      ]
    },
    "novelty1": {
      "agent": "claude-a",
      "model": "sonnet",
      "effort": "medium"
    },
    "novelty2": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "medium"
    },
    "tiebreak": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "high",
      "fallback_model": "sonnet"
    },
    "referee_spec": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "high",
      "fallback_model": "sonnet"
    },
    "builder": {
      "agent": "claude-a",
      "model": "sonnet",
      "effort": "medium"
    },
    "referee_judge": {
      "agent": "claude-a",
      "model": "opus",
      "effort": "high",
      "fallback_model": "sonnet"
    },
    "synth": {
      "agent": "claude-a",
      "model": "haiku",
      "effort": "low"
    }
  },
  "fallback": {
    "codex": "claude-b"
  },
  "budget": {
    "session_usd": 5,
    "day_usd": 10
  }
}